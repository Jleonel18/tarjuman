{
  "name": "tarjuman",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p apps/web --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"packages/**/*.css\" \"apps/**/*.css\" --allow-empty-input",
    "lint:arch": "depcruise packages apps tests --config .dependency-cruiser.cjs",
    "lint:i18n": "tsx scripts/lint-i18n.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:redteam": "vitest run --project adversarial",
    "test:live:guardrails": "TARJUMAN_LIVE=1 vitest run --project guardrails-live",
    "test:live:redteam": "TARJUMAN_LIVE=1 vitest run --project adversarial-live",
    "test:live:ollama": "TARJUMAN_LIVE=1 vitest run --project provider-live"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-i18next": "^6.1.5",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-use-logical": "^2.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
