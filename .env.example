# Copy to `.env` (git-ignored) and fill in. NEVER commit `.env`.
#
# This is NOT how end users provide their key: in the app, users enter their own key in the UI
# (BYOK). These variables exist only for developer tooling that must call the real provider.

# A throwaway Anthropic API key owned by the project/developer, ideally with a low spend limit.
# Used by: the provider spike (T018) and the live-model suites (`pnpm test:live:*`).
# Never use a personal production key here.
TARJUMAN_TEST_KEY=
