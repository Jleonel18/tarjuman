# Copy to `.env` (git-ignored) and fill in. NEVER commit `.env`.
#
# This is NOT how end users provide their key: in the app, users enter their own key in the UI
# (BYOK). These variables exist only for developer tooling that must call the real provider.

# A throwaway Anthropic API key owned by the project/developer, ideally with a low spend limit.
# Used by: the provider spike (T018) and the live-model suites (`pnpm test:live:*`).
# Never use a personal production key here.
TARJUMAN_TEST_KEY=

# A Google Gemini API key owned by the developer (from Google AI Studio: `AIza…` or `AQ.…`).
# Developer tooling only (`pnpm test:live:gemini`, `TARJUMAN_PROVIDER=gemini` for the guardrail
# tools). Learners never provide a key this way: they enter their own in the app (BYOK).
GEMINI_API_KEY=

# A Google Cloud API key with "YouTube Data API v3" enabled (`AIza…`), owned by the developer.
# Developer tooling only (`pnpm test:live:youtube`). A Gemini `AQ.…` key does NOT work for YouTube.
# Learners enter their own key in the app (BYOK).
YOUTUBE_API_KEY=
